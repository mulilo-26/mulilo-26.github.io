# Normalize all text files to LF in the repository, regardless of client OS.
* text=auto eol=lf

# Binary assets — never normalize line endings.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.pdf   binary
